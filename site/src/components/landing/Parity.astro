---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

const node = `const { load } = require('@nascent-tech/memless');

const db = load('data.yaml');
db.begin();
db.execute("UPDATE wallets SET amount = 50 WHERE id = 'w1'");
db.commit(); // data.yaml is rewritten once, here

db.query('SELECT id, amount FROM wallets');
// { columns: ['id', 'amount'], rows: [['w1', 50]] }
db.release();`;

const php = `<?php

use Memless\\Instance;

$db = Instance::load('data.yaml');
$db->begin();
$db->execute("UPDATE wallets SET amount = 50 WHERE id = 'w1'");
$db->commit(); // data.yaml is rewritten once, here

$db->query('SELECT id, amount FROM wallets');
// [['id' => 'w1', 'amount' => 50]]
$db->release();`;

const go = `db, err := memless.Load("data.yaml")
if err != nil {
	log.Fatal(err)
}
defer db.Release()

if err := db.Begin(); err != nil {
	log.Fatal(err)
}
if _, err := db.Execute("UPDATE wallets SET amount = 50 WHERE id = 'w1'"); err != nil {
	log.Fatal(err)
}
if err := db.Commit(); err != nil { // data.yaml is rewritten once, here
	log.Fatal(err)
}

rows, err := db.Query("SELECT id, amount FROM wallets")
if err != nil {
	log.Fatal(err)
}
// rows.Columns: [id amount]  rows.Rows: [[w1 50]]`;
---

<section class="parity not-content" aria-labelledby="parity">
	<div class="intro">
		<h2 id="parity">Same file, same SQL, same answer — in three languages.</h2>
		<p>Every bridge runs the same native engine. Pick your language once: every sample on the site follows.</p>
	</div>
	<div class="sample">
		<Tabs syncKey="lang">
			<TabItem label="Node.js" icon="seti:javascript"><Code code={node} lang="js" /></TabItem>
			<TabItem label="PHP" icon="seti:php"><Code code={php} lang="php" /></TabItem>
			<TabItem label="Go" icon="seti:go"><Code code={go} lang="go" /></TabItem>
		</Tabs>
	</div>
	<div class="errors">
		<h3>Even the errors match</h3>
		<p>A refusal carries the same message in every language, so a test can assert on it.</p>
		<dl class="refusal">
			<div><dt>Query</dt><dd><code>SELECT nope FROM users</code></dd></div>
			<div><dt>Refusal</dt><dd><code>no column "nope" in table "users"</code></dd></div>
		</dl>
		<dl>
			<div><dt>Node.js</dt><dd><code>MemlessRefusal</code></dd></div>
			<div><dt>PHP</dt><dd><code>Memless\MemlessRefusal</code></dd></div>
			<div><dt>Go</dt><dd><code>*memless.RefusalError</code></dd></div>
		</dl>
	</div>
</section>

<style>
	.parity {
		margin-inline: calc(50% - 50vw);
		padding: 6.5rem max(calc(50vw - 50%), 1rem);
		background: var(--ml-band);
		color: #f3f1ea;
		display: grid;
		grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		gap: 2rem 3rem;
	}
	.intro {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		max-width: 47.5rem;
	}
	h2 {
		margin: 0;
		font-family: var(--__sl-font-mono);
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.035em;
		color: #f3f1ea;
	}
	p {
		margin: 0;
		font-size: var(--sl-text-lg);
		line-height: 1.6;
		color: #c9ccd1;
	}
	.sample {
		min-width: 0;
	}
	.sample :global([role='tablist']) {
		--sl-color-gray-5: #30333b;
		--sl-color-text-accent: #8fd3b0;
		--sl-color-gray-3: #a7abb3;
		--sl-color-white: #f3f1ea;
	}
	.errors {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		color: #f3f1ea;
	}
	.errors p {
		font-size: var(--sl-text-base);
	}
	.refusal {
		background: #1e2127;
	}
	.refusal div {
		flex-direction: column;
		gap: 0.25rem;
	}
	.refusal dt {
		font-size: var(--sl-text-sm);
		font-weight: 500;
		color: #a7abb3;
	}
	.refusal code {
		color: #f3f1ea;
		overflow-wrap: anywhere;
	}
	.refusal div + div code {
		color: #f2b880;
	}
	dl {
		margin: 0;
		border-radius: 0.75rem;
		border: 1px solid #2c2f37;
	}
	dl div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.875rem 1.25rem;
	}
	dl div + div {
		border-top: 1px solid #2c2f37;
	}
	dt {
		font-weight: 500;
	}
	dd {
		margin: 0;
	}
	dd code {
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-sm);
		color: #9ec5f8;
		background: none;
	}
	@media (max-width: 50rem) {
		.parity {
			padding-block: 3rem;
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
