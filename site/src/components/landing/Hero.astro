---
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const title = data.hero?.title ?? data.title;

const fixture = `users:
  - id: 1
    name: Ada
  - id: 2
    name: Grace
wallets:
  - id: w1
    user_id: 2   # points at users.id = 2
    amount: 100`;

const query = `SELECT users.name, wallets.amount
FROM wallets
INNER JOIN users ON wallets.user_id = users.id`;
---

<section class="hero not-content">
	<div class="pitch">
		<h1 id="_top">{title}</h1>
		<p class="lede">
			From PHP, Go or Node.js, Memless loads a YAML file into memory, runs plain SQL against it,
			and writes every accepted change back to the file. No schema to declare, no server to start —
			made for test fixtures and demos.
		</p>
		<div class="install">
			<Tabs syncKey="lang">
				<TabItem label="Node.js" icon="seti:javascript">
					<Code code="npm install @nascent-tech/memless" lang="sh" />
				</TabItem>
				<TabItem label="PHP" icon="seti:php">
					<Code code="composer require nascent-tech/memless" lang="sh" />
				</TabItem>
				<TabItem label="Go" icon="seti:go">
					<Code code="go get github.com/nascent-tech/memless-go" lang="sh" />
				</TabItem>
			</Tabs>
		</div>
		<div class="actions">
			<a class="button primary" href="/getting-started/quick-start/">Follow the quick start</a>
			<a class="button" href="/reference/sql/">See the supported SQL</a>
		</div>
	</div>
	<div class="demo">
		<Code code={fixture} lang="yaml" title="data.yaml" />
		<div class="query">
			<Code code={query} lang="sql" frame="none" />
			<table>
				<thead>
					<tr><th scope="col">users.name</th><th scope="col">wallets.amount</th></tr>
				</thead>
				<tbody>
					<tr><td>Grace</td><td>100</td></tr>
				</tbody>
			</table>
		</div>
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4.5rem;
		align-items: center;
		padding-block: 4rem 5rem;
	}
	.pitch {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	h1 {
		margin: 0;
		font-family: var(--__sl-font-mono);
		font-size: clamp(2.125rem, 4vw, 3.5rem);
		font-weight: 700;
		line-height: 1.08;
		color: var(--sl-color-white);
	}
	.lede {
		margin: 0;
		font-size: var(--sl-text-xl);
		line-height: 1.55;
		color: var(--ml-muted);
		max-width: 35rem;
	}
	.install {
		max-width: 35rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.button {
		min-height: 3rem;
		padding: 0 1.375rem;
		display: inline-flex;
		align-items: center;
		border-radius: 0.75rem;
		border: 1px solid var(--sl-color-gray-5);
		color: var(--sl-color-white);
		font-weight: 600;
		text-decoration: none;
	}
	.button {
		transition: background-color 160ms cubic-bezier(0.16, 1, 0.3, 1), border-color 160ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.button:hover {
		border-color: var(--sl-color-gray-3);
		background: var(--sl-color-gray-6);
	}
	.button.primary {
		border-color: var(--ml-button);
		background: var(--ml-button);
		color: var(--ml-button-text);
	}
	.button.primary:hover {
		border-color: var(--ml-button-hover);
		background: var(--ml-button-hover);
	}
	.demo {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.query {
		border-radius: 0.75rem;
		border: 1px solid #2c2f37;
		background: #16181d;
		overflow: hidden;
	}
	table {
		width: calc(100% - 2rem);
		margin: 0 1rem 1rem;
		table-layout: fixed;
		border-collapse: collapse;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-sm);
	}
	th,
	td {
		overflow-wrap: anywhere;
	}
	th {
		text-align: left;
		padding: 0.5rem 0.75rem;
		font-weight: 500;
		color: #a7abb3;
		border-bottom: 1px solid #30333b;
	}
	td {
		padding: 0.5rem 0.75rem;
		color: #f2b880;
	}
	td + td {
		color: #9ec5f8;
	}
	@media (max-width: 50rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr);
			gap: 2.5rem;
			padding-block: 2rem 3rem;
		}
	}
</style>
