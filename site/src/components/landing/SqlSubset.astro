---
const understood = [
	'SELECT … FROM … WHERE … ORDER BY',
	'one INNER JOIN on a <name>_id relation',
	'COUNT(*) and SUM(column)',
	'INSERT, UPDATE, DELETE',
	'BEGIN, COMMIT, ROLLBACK',
];

const refused = [
	'GROUP BY, LIMIT, OFFSET',
	'more than one JOIN',
	'LIKE, IN, arithmetic, subqueries',
	'CREATE, ALTER, DROP',
	'sorting or summing mixed types',
];
---

<section class="sql not-content" aria-labelledby="sql">
	<div class="head">
		<h2 id="sql">A deliberate subset of SQL</h2>
		<a href="/reference/sql/">Full SQL reference →</a>
	</div>
	<div class="columns">
		<div class="column">
			<h3>Understood</h3>
			<ul>
				{understood.map((item) => (
					<li>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10" /></svg>
						{item}
					</li>
				))}
			</ul>
		</div>
		<div class="column refused">
			<h3>Refused, never approximated</h3>
			<ul>
				{refused.map((item) => (
					<li>
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
						{item}
					</li>
				))}
			</ul>
		</div>
	</div>
</section>

<style>
	.sql {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		padding-block: 7rem;
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 1rem 2rem;
	}
	h2 {
		margin: 0;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-3xl);
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
	}
	.head a {
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.column {
		padding: 2rem;
		border-radius: 1rem;
		background: var(--ml-panel);
		border: 1px solid var(--ml-panel-border);
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.column.refused {
		background: var(--ml-refused);
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-xl);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-family: var(--__sl-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	li {
		display: flex;
		gap: 0.75rem;
		align-items: center;
	}
	svg {
		flex-shrink: 0;
		color: var(--ml-ok);
	}
	.refused svg {
		color: var(--ml-no);
	}
	@media (max-width: 50rem) {
		.sql {
			padding-block: 3rem;
		}
		.columns {
			grid-template-columns: minmax(0, 1fr);
		}
		.column {
			padding: 1.25rem;
		}
	}
</style>
