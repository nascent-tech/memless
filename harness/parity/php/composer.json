{
    "name": "memless/parity-php",
    "description": "Parity driver for the memless PHP bridge",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "nascent-tech/memless": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../bindings/php",
            "options": {
                "versions": {
                    "nascent-tech/memless": "dev-main"
                }
            }
        }
    ],
    "config": {
        "sort-packages": true
    }
}
